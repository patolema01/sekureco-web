# '! Access-Control-Allow-Origin' saca el '*' que Pages agrega a todo: el sitio no necesita que otros orígenes lo lean
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), serial=(), hid=(), display-capture=(), idle-detection=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Permitted-Cross-Domain-Policies: none
  ! Access-Control-Allow-Origin

# caché (Cache-Control va solo en reglas específicas: si dos reglas lo ponen, Pages junta los valores)
# HTML: siempre se revalida, así siempre pide los CSS/JS de su versión
/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

# Pages sirve privacidad.html en /privacidad (sin .html): esa URL no entra en /*.html
/privacidad
  Cache-Control: no-cache

# CSS y JS con huella de contenido: la regla de un año (immutable) la agrega tools/build.py en
# dist/_headers, con el nombre exacto de cada archivo. Acá no: si el build no corriera, un
# styles.css sin huella quedaría guardado un año.

# sin huella: una semana
/assets/fonts/*
  Cache-Control: public, max-age=604800

/assets/brand/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# imagen para compartir (Open Graph): sin huella, la URL tiene que ser estable; la genera tools/og.py
/assets/og/*
  Cache-Control: public, max-age=604800
